{
	"version": "0.2.0",
	"configurations": [
        {
            "type": "debugpy",
            "name": "run",
            "request": "launch",
            "program": "${workspaceFolder}/src/main/python/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "templates_base_dir": "src/main/resources/templates",
                "output_base_dir": "debug_output",
                "id_db_base_dir": "debug_id_db",
                "id_db_persist": "global",
                "mail_idle_timeout_sec": "3",
                "output_write": "attachments",
                "cache_path": "debug_cache/imap2files.cachedb",
                "template_attachment_filename": "{{ uid }} - {{ full_filename }}",

                // "cache_start_fresh": "1",
                // "mail_disposition": "mark_flagged",
                // "mail_filter": "unflagged",
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        }
	]
}
